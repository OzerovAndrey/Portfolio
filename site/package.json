{
  "name": "portfolio-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "tokens": "node ../tools/build-css.mjs --out-manifest src/generated/tokens-manifest.json",
    "check:tokens": "node ../tools/check-tokens.mjs",
    "dev": "npm run tokens && astro dev",
