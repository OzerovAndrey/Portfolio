---
// Живе демо в iframe на всіх ширинах. Iframe вставляється, коли секція підходить до в'юпорту — не б'є по Lighthouse.
// Мобільні: вертикальна сцена 9:16 — демо показує свою мобільну версію.
// Демо читає ?theme=light|dark (і ?brand) — iframe відкривається в поточній темі сайту. ?lang/embed демо поки ігнорує (demo-02).
// До завантаження iframe — статичний постер демо (public/demo/poster-*-light|dark.webp, та сама пропорція): без порожнього блоку й без CLS.
// Пропорції рамки підібрані під демо: перший ряд карток ігор видно повністю над плаваючою панеллю демо (88 px знизу).
import Button from "./Button.astro";
import { config } from "../config";
import { t, type Locale } from "../i18n";

interface Props { lang: Locale }
const { lang } = Astro.props;
const d = t(lang);
const url = new URL(config.demoUrl);
url.searchParams.set("lang", lang);
const full = url.href;
url.searchParams.set("embed", "1");
const embed = url.href;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const poster = (size: string, theme: string) => `${base}demo/poster-${size}-${theme}.webp`;
---
<figure class="demo" data-demo-src={embed}>
  <div class="demo__toolbar" aria-hidden="true">
    <span class="demo__dot"></span><span class="demo__dot"></span><span class="demo__dot"></span>
  </div>
  <div class="demo__stage">
    {["light", "dark"].map((th) => (
      <picture class={`demo__poster demo__poster--${th}`}>
        <source media="(min-width: 1200px)" srcset={poster("wide", th)} width="1232" height="1141" />
        <source media="(min-width: 900px)" srcset={poster("mid", th)} width="960" height="1200" />
        <img src={poster("mobile", th)} width="716" height="1272" alt={d.demo.frameTitle} loading="lazy" decoding="async" />
      </picture>
    ))}
    <p class="demo__placeholder sr-only">{d.demo.loading}</p>
  </div>
  <figcaption class="demo__caption">
    <span class="ts-body-sm-regular">{d.demo.lead}</span>
    <Button variant="secondary" size="md" href={full} target="_blank" rel="noopener" data-event="demo_open_fullscreen">{d.demo.openFull} ↗</Button>
  </figcaption>
</figure>

<script define:vars={{ title: d.demo.frameTitle }}>
  (() => {
    const fig = document.querySelector("[data-demo-src]");
    if (!fig) return;
    const mount = () => {
      const f = document.createElement("iframe");
      // тема демо = поточна тема сайту
      const src = new URL(fig.dataset.demoSrc);
      src.searchParams.set("theme", document.documentElement.dataset.theme === "dark" ? "dark" : "light");
      f.src = src.href; f.title = title; f.loading = "lazy";
      f.referrerPolicy = "strict-origin-when-cross-origin";
      f.addEventListener("load", () => fig.classList.add("is-loaded"), { once: true });
      fig.querySelector(".demo__stage").append(f);
    };
    if (!("IntersectionObserver" in window)) return mount();
    const io = new IntersectionObserver((e) => { if (e.some((x) => x.isIntersecting)) { io.disconnect(); mount(); } }, { rootMargin: "400px 0px" });
    io.observe(fig);
  })();
</script>

<style>
  .demo { position: relative; z-index: 2; margin: 0; box-shadow: var(--demoFrame-boxShadow); display: flex; flex-direction: column; background: var(--demoFrame-bg); border: var(--demoFrame-borderWidth) solid var(--demoFrame-br); border-radius: var(--demoFrame-borderRadius); overflow: hidden; }
  .demo__toolbar { display: flex; align-items: center; gap: var(--space-gap-sm); height: var(--demoFrame-toolbar-height); padding-inline: var(--demoFrame-toolbar-paddingH); background: var(--demoFrame-toolbar-bg); border-bottom: var(--demoFrame-borderWidth) solid var(--demoFrame-br); }
  .demo__dot { width: var(--space-gap-lg); height: var(--space-gap-lg); border-radius: var(--borderRadius-control); background: var(--demoFrame-br); }
  .demo__stage { position: relative; overflow: hidden; background: var(--demoFrame-placeholder-bg); aspect-ratio: 9 / 16; }
  .demo__poster, .demo__poster img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .demo__poster img { object-fit: cover; object-position: top; }
  :global(:root[data-theme="dark"]) .demo__poster--light, :global(:root:not([data-theme="dark"])) .demo__poster--dark { display: none; }
  .demo__stage :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; opacity: 0; transition: opacity var(--motion-duration-base) var(--motion-easing-out); }
  .demo.is-loaded .demo__stage :global(iframe) { opacity: 1; }
  .demo__caption { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--demoFrame-gap); padding: var(--space-padding-md); color: var(--demoFrame-caption-color); }
  /* Пропорції під сітку демо: 4 колонки до ~1040 px контенту, далі 6. Висота = перший ряд карток + панель демо */
  @media (min-width: 900px) { .demo__stage { aspect-ratio: 4 / 5; } }
  @media (min-width: 1104px) { .demo__stage { aspect-ratio: 1 / 1; } }
  @media (min-width: 1200px) { .demo__stage { aspect-ratio: 27 / 25; } }
</style>
