---
// Схема в HTML/CSS (не картинка): вузли зі стрілками. Шари токенів — стовпчик; пайплайн — стовпчик на вузьких, ряд на широких.
interface Props { items: { name: string; detail: string; example?: string }[]; label: string; row?: boolean }
const { items, label, row = false } = Astro.props;
---
<div class:list={["flow", row && "flow--row"]} role="list" aria-label={label}>
  {items.map((it, i) => (
    <>
      {i > 0 && <span class="flow__arrow ts-title-t3" aria-hidden="true"></span>}
      <div class="flow__node" role="listitem">
        <span class="flow__name ts-title-t5">{it.name}</span>
        <p class="flow__detail ts-body-sm-regular">{it.detail}</p>
        {it.example && <code class="flow__example ts-body-sm-strong">{it.example}</code>}
      </div>
    </>
  ))}
</div>

<style>
  .flow { display: flex; flex-direction: column; align-items: stretch; gap: var(--flow-gap); }
  .flow__node { display: flex; flex-direction: column; gap: var(--flow-node-gap); flex: 1; padding: var(--flow-node-padding); background: var(--flow-node-bg); border: var(--flow-borderWidth) solid var(--flow-node-br); border-radius: var(--flow-node-borderRadius); }
  .flow__node:last-child { border-color: var(--flow-node-accent-br); }
  .flow__name { color: var(--flow-node-title-color); }
  .flow__detail { color: var(--flow-node-detail-color); }
  .flow__example { color: var(--flow-node-title-color); overflow-wrap: anywhere; }
  .flow__arrow { align-self: center; color: var(--flow-arrow-color); }
  .flow__arrow::before { content: "↓"; }
  @media (min-width: 1024px) {
    .flow--row { flex-direction: row; align-items: stretch; }
    .flow--row .flow__arrow { align-self: center; }
    .flow--row .flow__arrow::before { content: "→"; }
  }
</style>
