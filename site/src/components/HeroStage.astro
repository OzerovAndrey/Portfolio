---
// Hero: лобі-мокап на компонентних токенах демо + перемикач брендів (ті самі 4, що в живому демо).
// Бренд перемикається атрибутом data-brand на елементах .stage-scope (токени демо оголошені на scope —
// src/generated/stage/stage.css, npm run tokens:stage). Арт ігор — ілюстрації демо (SVG-спрайт на --illustration-*,
// дзеркало lib/demo-illustrations.ts), тому перефарбовується разом із брендом і нічого не важить як картинка.
// Мокап aria-hidden: для скрінрідера зміст несе перемикач + рядок статусу (aria-live). Цифри — з токенів при білді.
import "../generated/stage/stage.css";
import { BRAND_NAME, LOBBY_ART, STAGE_BRANDS, brandDiff, illustration } from "../lib/stage";
import { t, type Locale } from "../i18n";

interface Props { lang: Locale }
const s = t(Astro.props.lang).stage;
const first = STAGE_BRANDS[0];
// Арт — зовнішній спрайт (pages/demo-art.svg.ts): кешується й не блокує перший рендер
const art = (k: string) => `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}demo-art.svg#ill-${k}`;
const jackpot = illustration("jackpot");
const i18n = { announceBrand: s.announceBrand, names: BRAND_NAME };
---
<div class="hero__stage stage" data-stage data-current={first} data-diff={JSON.stringify(brandDiff)} data-i18n={JSON.stringify(i18n)}>
  <div class="stage__viewport" aria-hidden="true">
    <div class="stage__light stage-scope" data-brand={first} data-stage-brand></div>
    <div class="stage__tilt" data-tilt>
      <div class="lobby stage-scope" data-brand={first} data-stage-brand data-swap>
        <div class="lobby__bar">
          <span class="lobby__logo ts-title-t5"><i class="lobby__mark"></i>{STAGE_BRANDS.map((b) => <span data-for={b}>{BRAND_NAME[b]}</span>)}</span>
          <span class="lobby__btn lobby__btn--sm ts-label-sm">{s.lobby.join}</span>
        </div>
        <ul class="lobby__chips">
          {s.lobby.chips.map((c, i) => <li class:list={["lobby__chip ts-label-sm", i === 0 && "is-selected"]}>{c}</li>)}
        </ul>
        <div class="lobby__promo">
          <svg class="lobby__scene" viewBox={`0 0 ${jackpot.w} ${jackpot.h}`} focusable="false"><use href={art("jackpot")} /></svg>
          <div class="lobby__promoText">
            <p class="lobby__promoTitle ts-title-t4">{s.lobby.promoTitle}</p>
            <p class="lobby__promoLead ts-body-xs-regular">{s.lobby.promoText}</p>
            <span class="lobby__btn ts-label-sm">{s.lobby.promoCta}</span>
          </div>
        </div>
        <ul class="lobby__tiles">
          {s.lobby.tiles.map((tile, i) => {
            const a = LOBBY_ART[i % LOBBY_ART.length];
            const ill = illustration(a.ill);
            return (
              <li class="tile">
                <span class="tile__cover" style={`--art: var(--art-${a.art}-bg)`}>
                  <i class="tile__glow"></i>
                  <svg class="tile__ill" viewBox={`0 0 ${ill.w} ${ill.h}`} focusable="false"><use href={art(a.ill)} /></svg>
                </span>
                <span class="tile__title ts-body-xs-strong">{tile.title}</span>
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  </div>

  <div class="switch glass" role="group" aria-label={s.brandGroup}>
    {STAGE_BRANDS.map((b, i) => (
      <button type="button" class="switch__item ts-label-sm" aria-pressed={i === 0 ? "true" : "false"} data-set-brand={b} data-event="hero_switch_brand">
        <i class="switch__dot stage-scope" data-brand={b} aria-hidden="true"></i>{BRAND_NAME[b]}
      </button>
    ))}
  </div>
  <p class="stage__status ts-body-sm-regular" aria-live="polite" data-live>{s.status}</p>
</div>

<script>
  import "../scripts/hero-stage";
</script>

<style>
  .stage { position: relative; display: flex; flex-direction: column; align-items: center; gap: var(--stage-gap); min-width: 0; }
  .stage__viewport { position: relative; width: 100%; }
  .stage__light {
    position: absolute; inset: calc(var(--stage-depth) * -0.5); z-index: 0; pointer-events: none;
    background: radial-gradient(closest-side, var(--stageLight-bg), transparent);
  }
  .stage__tilt { position: relative; z-index: 1; }

  /* Бренд-специфічні підписи: видно тільки поточний бренд сцени */
  .stage[data-current="aurum"] [data-for]:not([data-for="aurum"]),
  .stage[data-current="nova"] [data-for]:not([data-for="nova"]),
  .stage[data-current="fiesta"] [data-for]:not([data-for="fiesta"]),
  .stage[data-current="ultra"] [data-for]:not([data-for="ultra"]) { display: none; }

  /* ---------- лобі: тільки компонентні токени демо (card, header, chip, promo, art, gameTile, button, illustration) ----------
     Стани, що проходять AA в усіх 4 брендах × 2 темах: chip.*.hover, текст promo на promo.overlay.bg, плитка без провайдера (tasks/demo-05) */
  .lobby {
    display: flex; flex-direction: column; gap: var(--card-default-gap-sm);
    padding: var(--card-default-paddingV-sm) var(--card-default-paddingH-sm);
    background: var(--card-default-bg); border: var(--card-default-borderWidth) solid var(--card-default-br); border-radius: var(--card-default-borderRadius);
    box-shadow: var(--stage-plane-boxShadow);
  }
  .lobby__bar { display: flex; align-items: center; justify-content: space-between; gap: var(--header-gap); }
  .lobby__logo { display: inline-flex; align-items: center; gap: var(--header-actions-gap); color: var(--header-logo-color); }
  .lobby__mark { display: inline-block; width: var(--chip-iconSize); height: var(--chip-iconSize); border-radius: var(--button-borderRadius); background: var(--header-logo-iconColor); }
  .lobby__btn {
    display: inline-flex; align-items: center; flex: none; height: var(--button-size-sm); padding-inline: var(--button-paddingH-sm);
    border-radius: var(--button-borderRadius); background: var(--button-primary-bg-default); color: var(--button-primary-color-default);
  }
  .lobby__chips { display: flex; flex-wrap: wrap; gap: var(--chip-gap); }
  .lobby__chip {
    display: inline-flex; align-items: center; height: var(--chip-size-sm); padding-inline: var(--chip-paddingH-sm);
    border: var(--chip-borderWidth) solid var(--chip-br-default); border-radius: var(--chip-borderRadius);
    background: var(--chip-bg-default); color: var(--chip-color-hover);
  }
  .lobby__chip.is-selected { background: var(--chip-selected-bg-hover); border-color: var(--chip-selected-br-hover); color: var(--chip-selected-color-hover); }

  /* Промо як у демо: сцена jackpot праворуч, текст на overlay */
  .lobby__promo { position: relative; display: flex; overflow: hidden; isolation: isolate; border-radius: var(--promo-borderRadius); background: var(--art-jackpot-bg); aspect-ratio: 21 / 8; }
  .lobby__scene { position: absolute; z-index: -1; inset-block: 0; inset-inline-end: 0; height: 100%; width: auto; }
  .lobby__promoText {
    display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: var(--space-gap-sm);
    width: 60%; padding: var(--promo-paddingV-xs) var(--promo-paddingH-xs); background: var(--promo-overlay-bg);
  }
  .lobby__promoTitle { color: var(--promo-title-color); }
  .lobby__promoLead { color: var(--promo-text-color); }

  /* Плитки ігор: обкладинка 3:4 з ілюстрацією демо (як .game-tile у демо) */
  .lobby__tiles { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gameTile-gap); }
  .tile { display: flex; flex-direction: column; gap: var(--gameTile-info-gap); min-width: 0; }
  .tile__cover {
    position: relative; display: grid; place-items: center; overflow: hidden; container-type: size;
    aspect-ratio: 3 / 4; border-radius: var(--gameTile-borderRadius); background: var(--art);
  }
  .tile__glow { position: absolute; width: 72cqw; aspect-ratio: 1; border-radius: var(--brandSwitch-item-borderRadius); background: var(--illustration-glow); opacity: var(--stage-glow-opacity); }
  .tile__ill { position: relative; width: 100cqw; height: auto; }
  .tile__title { color: var(--gameTile-title-color); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  /* Зміна бренду: коротка «пульсація» лобі easing'ом і тривалістю самого бренду (tokens/site/demo-motion.json) */
  @keyframes stage-swap { from { transform: scale(0.97); } }
  @media (prefers-reduced-motion: no-preference) {
    .lobby.is-swapping { animation: stage-swap var(--motion-duration-brand, var(--motion-duration-base)) var(--motion-easing-brand, var(--motion-easing-standard)) both; }
    /* Паралакс від курсора (hero-stage.ts ставить --tilt-x/-y від -1 до 1, тільки desktop з точним вказівником) */
    .stage__tilt {
      transform: perspective(var(--stage-perspective)) rotateX(calc(var(--tilt-y, 0) * var(--stage-parallax) * -1)) rotateY(calc(var(--tilt-x, 0) * var(--stage-parallax)));
      transition: transform var(--motion-duration-scene) var(--motion-easing-emphasized);
    }
  }

  /* ---------- перемикач (glass) ---------- */
  .switch { display: inline-flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: var(--brandSwitch-gap); padding: var(--brandSwitch-padding); border-radius: var(--glass-borderRadius); position: relative; z-index: 2; }
  .switch__item {
    display: inline-flex; align-items: center; gap: var(--brandSwitch-item-gap); min-height: var(--brandSwitch-item-size); padding-inline: var(--brandSwitch-item-paddingH);
    border: 0; border-radius: var(--brandSwitch-item-borderRadius); cursor: pointer;
    background: var(--brandSwitch-item-bg-default); color: var(--brandSwitch-item-color-default);
    transition: background-color var(--motion-duration-fast) var(--motion-easing-out);
  }
  .switch__item:hover { background: var(--brandSwitch-item-bg-hover); }
  .switch__item[aria-pressed="true"] { background: var(--brandSwitch-item-bg-active); color: var(--brandSwitch-item-color-active); }
  .switch__dot { display: inline-block; width: var(--space-gap-lg); height: var(--space-gap-lg); border-radius: var(--brandSwitch-item-borderRadius); background: var(--illustration-primary-base); }
  .stage__status { position: relative; z-index: 2; color: var(--legend-detail-color); text-align: center; }
</style>
