---
// Hero (Home, перший екран): роль → твердження → CTA ліворуч, праворуч — СПРАВЖНЯ жива система в iframe (той самий origin, GitHub Pages).
// iframe = миттєвий доказ, «Open live system ↗» = повноекранне дослідження. Стартовий стан демо — Aurum + Dark через ?brand&theme
// (демо читає їх при старті). Тему портфоліо в iframe не прокидаємо.
// Розміри: рамка має фіксовані пропорції (aspect-ratio) → без CLS. Широка рамка: демо рендериться на віртуальній ширині
// (десктоп-розкладка демо від 768) і пропорційно зменшується; вузька — рідна мобільна розкладка демо, без масштабу.
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import { BRANDS, states } from "../lib/exhibit";
import { config } from "../config";
import { t, type Locale } from "../i18n";

interface Props { lang: Locale }
const { lang } = Astro.props;
const h = t(lang).hero;
// Підпис primary CTA: тонке кільце з product1 усіх чотирьох брендів демо (значення — з токенів під час білду, не з поточного бренду).
// Портфоліо лишається монохромним; колір — лише в цій маленькій деталі
const brandAccent = BRANDS.map((b, i) => `--mb-${i + 1}: ${states[`${b}|light`].colors["color.product1"]}`).join("; ");
const live = new URL(config.demoUrl);
live.searchParams.set("brand", "aurum");
live.searchParams.set("theme", "dark");
---
<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="hero__role ts-overline-md">{h.role}</p>
      <h1 class="hero__title ts-display-d1" id="hero-title">
        {h.title.map((line) => <span class="hero__line">{line}</span>)}
      </h1>
      <p class="hero__subtitle ts-body-lg-regular">{h.subtitle}</p>
      <div class="hero__actions">
        <Button size="lg" href={config.demoUrl} target="_blank" rel="noopener" aria-label={h.ctaLiveLabel} class="hero__cta hero__cta--primary" style={brandAccent} data-event="cta_live_system"><span>{h.ctaLive}</span><span class="cta-mark" aria-hidden="true"><Icon name="arrowUpRight" class="cta-mark__icon" /></span></Button>
        <Button size="lg" variant="secondary" href="#explore" class="hero__cta hero__cta--secondary hero__more hero__more--desktop" data-explore data-event="cta_explore"><span>{h.ctaHow}</span><Icon name="arrowDown" class="cta-arrow" /></Button>
      </div>
    </div>

    <div class="hero__product">
      <div class="hero__live" data-live-frame>
        <!-- src ставить скрипт після підгонки розміру: демо одразу стартує у правильній розкладці, без перебудови мобільна → десктоп -->
        <iframe class="hero__iframe" data-src={live.href} title={h.liveTitle} referrerpolicy="strict-origin-when-cross-origin" data-live-iframe></iframe>
        <noscript><iframe class="hero__iframe" src={live.href} title={h.liveTitle}></iframe></noscript>
      </div>
      <!-- мобільні: другорядна дія — після живої системи -->
      <Button size="lg" variant="secondary" href="#explore" class="hero__cta hero__cta--secondary hero__more hero__more--mobile" data-explore data-event="cta_explore"><span>{h.ctaHow}</span><Icon name="arrowDown" class="cta-arrow" /></Button>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-hero]");
  if (root) {
    // Жива система: рамка задає розмір (aspect-ratio), iframe підганяється. Рамка ≥ 448 — десктоп-розкладка демо (від 768) на віртуальній
    // ширині 960 (рамка ≥ 600) або 800 (вужча, напр. 1024 у дві колонки) і масштаб = ширина рамки / віртуальна; вужча за 448 —
    // рідна мобільна розкладка демо 1:1. Без JS iframe просто заповнює рамку
    const frame = root.querySelector<HTMLElement>("[data-live-frame]");
    const iframe = root.querySelector<HTMLIFrameElement>("[data-live-iframe]");
    if (frame && iframe) {
      const MIN_SCALED = 448;
      const fit = () => {
        const w = frame.clientWidth, hgt = frame.clientHeight;
        if (!w || !hgt) return;
        const virtual = w >= 600 ? 960 : 800;
        const k = w >= MIN_SCALED ? Math.min(1, w / virtual) : 1;
        iframe.style.width = `${w / k}px`;
        iframe.style.height = `${hgt / k}px`;
        iframe.style.transform = k === 1 ? "" : `scale(${k})`;
      };
      new ResizeObserver(fit).observe(frame);
      fit();
      if (iframe.dataset.src) iframe.src = iframe.dataset.src;
    }
    // «Explore the system ↓»: перейти до акордеонів і відкрити перший (без JS — звичайний якір)
    root.querySelectorAll<HTMLAnchorElement>("[data-explore]").forEach((a) =>
      a.addEventListener("click", () => document.getElementById("explore")?.dispatchEvent(new CustomEvent("explore:open"))),
    );
  }
</script>

<style>
  /* Асиметрична композиція: текст (ідентичність → твердження → CTA) і продукт ділять перший екран.
     Мобільні: та сама послідовність стовпчиком — продукт одразу після CTA, до Positioning */
  .hero { background: var(--hero-bg); padding-block: var(--l-gap); }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--hero-gap) var(--l-gap); align-items: center; }
  .hero__copy { display: flex; flex-direction: column; align-items: flex-start; gap: var(--hero-gap); min-width: 0; }
  .hero__role { color: var(--hero-eyebrow-color); }
  .hero__title {
    color: var(--hero-title-color); text-wrap: balance; hyphens: none; overflow-wrap: break-word;
    font-size: var(--hero-title-fontSize); line-height: var(--hero-title-lineHeight); letter-spacing: var(--hero-title-letterSpacing);
  }
  .hero__line { display: block; }
  .hero__subtitle { color: var(--hero-subtitle-color); font-size: var(--hero-subtitle-fontSize); line-height: var(--hero-subtitle-lineHeight); max-width: var(--layout-measure-lead); }
  .hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--hero-actions-gap); margin-top: var(--space-gap-md); }
  /* Вузькі екрани: CTA стовпчиком — перенос кнопок не залежить від підміни шрифту (CLS) */
  @media (max-width: 559px) { .hero__actions { flex-direction: column; align-items: stretch; align-self: stretch; } }
  .hero__product { display: grid; gap: var(--space-gap-xl); min-width: 0; }

  /* CTA: одна геометрія (lg, той самий радіус, іконка md), різна вага. Primary — монохромна дія (action.*) з тонким внутрішнім контуром
     і «знаком» праворуч: квадрат iconSize.xl, кільце-градієнт із product1 чотирьох брендів (--mb-1…4 з токенів демо), заливка = фон кнопки.
     Hover: ледь помітна підсвітка знака кольорами брендів і зсув стрілки на 2 px по діагоналі. Secondary — ghost (action.secondary.*), стрілка вниз на 2 px */
  :global(a.btn.hero__cta--primary) {
    padding-inline-end: calc((var(--btn-size) - var(--iconSize-xl)) / 2);
    box-shadow: inset 0 0 0 var(--borderWidth-control) color-mix(in srgb, var(--btn-color) 14%, transparent);
  }
  .cta-mark {
    display: inline-grid; place-items: center; flex: none; width: var(--iconSize-xl); height: var(--iconSize-xl); box-sizing: border-box;
    border: calc(var(--borderWidth-control) * 1.5) solid transparent; border-radius: var(--borderRadius-control);
    background:
      linear-gradient(var(--btn-bg), var(--btn-bg)) padding-box,
      linear-gradient(135deg, var(--mb-1), var(--mb-2), var(--mb-3), var(--mb-4)) border-box;
    transition: background var(--motion-duration-base) var(--motion-easing-out);
  }
  .cta-mark :global(.cta-mark__icon), .hero__cta--secondary :global(.cta-arrow), :global(.hero__cta--secondary) :global(.cta-arrow) { transition: transform var(--motion-duration-fast) var(--motion-easing-out); }
  @media (hover: hover) {
    :global(a.btn.hero__cta--primary:hover) .cta-mark {
      background:
        linear-gradient(135deg, color-mix(in srgb, var(--mb-1) 16%, var(--btn-bg)), color-mix(in srgb, var(--mb-3) 16%, var(--btn-bg))) padding-box,
        linear-gradient(135deg, var(--mb-1), var(--mb-2), var(--mb-3), var(--mb-4)) border-box;
    }
    :global(a.btn.hero__cta--primary:hover) .cta-mark :global(.cta-mark__icon) { transform: translate(calc(var(--borderWidth-control) * 2), calc(var(--borderWidth-control) * -2)); }
    :global(a.btn.hero__cta--secondary:hover .cta-arrow) { transform: translateY(calc(var(--borderWidth-control) * 2)); }
  }
  :global(a.btn.hero__cta--primary:focus-visible) .cta-mark :global(.cta-mark__icon) { transform: translate(calc(var(--borderWidth-control) * 2), calc(var(--borderWidth-control) * -2)); }
  @media (prefers-reduced-motion: reduce) {
    .cta-mark { transition: none; }
    .cta-mark :global(.cta-mark__icon), :global(.hero__cta--secondary .cta-arrow) { transition: none; transform: none !important; }
  }
  /* друга дія: на десктопі поруч з основною, на мобільних — під сценою */
  .hero__product :global(.hero__more--mobile) { justify-self: center; }
  @media (max-width: 1023px) { .hero__actions :global(.hero__more--desktop) { display: none; } }
  @media (min-width: 1024px) { .hero__product :global(.hero__more--mobile) { display: none; } }
  /* Рамка живої системи: нейтральна, тонка межа, стриманий радіус, без хрому браузера й світіння. Колір дає сама система */
  .hero__live {
    position: relative; overflow: hidden; min-width: 0; aspect-ratio: 9 / 14;
    background: var(--demoFrame-placeholder-bg); border: var(--demoFrame-borderWidth) solid var(--demoFrame-br); border-radius: var(--demoFrame-borderRadius);
  }
  /* max-width: none — глобальне iframe { max-width: 100% } (base.css) інакше обрізає віртуальну ширину до рамки */
  .hero__iframe { position: absolute; inset-block-start: 0; inset-inline-start: 0; width: 100%; height: 100%; max-width: none; border: 0; transform-origin: 0 0; }
  @media (min-width: 480px) { .hero__live { aspect-ratio: 4 / 3; } }
  @media (min-width: 1024px) { .hero__live { aspect-ratio: 8 / 7; } }
  @media (min-width: 1024px) { .hero__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
  @media (min-width: 1280px) { .hero__grid { grid-template-columns: minmax(0, 6fr) minmax(0, 7fr); } }
</style>
