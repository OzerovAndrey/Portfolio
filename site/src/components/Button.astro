---
// Button на токенах button.* (ті самі, що в демо). Рендерить <a>, якщо є href.
interface Props {
  variant?: "primary" | "secondary" | "text";
  size?: "sm" | "md" | "lg";
  href?: string;
  type?: "button" | "submit";
  class?: string;
  [attr: string]: unknown;
}
const { variant = "primary", size = "md", href, type = "button", class: cls, ...rest } = Astro.props;
const Tag = href ? "a" : "button";
---
<Tag class:list={["btn", `btn--${variant}`, `btn--${size}`, size === "lg" ? "ts-label-lg" : "ts-label-md", cls]} href={href} type={href ? undefined : type} {...rest}>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex; align-items: center; justify-content: center;
    gap: var(--btn-gap);
    height: var(--btn-size); padding-inline: var(--btn-padH);
    border-radius: var(--button-borderRadius);
    border: var(--button-borderWidth-primary) solid transparent;
    background: var(--btn-bg); color: var(--btn-color);
    text-decoration: none; white-space: nowrap; cursor: pointer;
    transition: background-color 120ms ease-out;
  }
  .btn--sm { --btn-size: var(--button-size-sm); --btn-padH: var(--button-paddingH-sm); --btn-gap: var(--button-gap-sm); }
  .btn--md { --btn-size: var(--button-size-md); --btn-padH: var(--button-paddingH-md); --btn-gap: var(--button-gap-md); }
  .btn--lg { --btn-size: var(--button-size-lg); --btn-padH: var(--button-paddingH-lg); --btn-gap: var(--button-gap-lg); }

  .btn--primary { --btn-bg: var(--button-primary-bg-default); --btn-color: var(--button-primary-color-default); }
  .btn--primary:hover { --btn-bg: var(--button-primary-bg-hover); --btn-color: var(--button-primary-color-hover); }
  .btn--primary:active { --btn-bg: var(--button-primary-bg-active); --btn-color: var(--button-primary-color-active); }
  .btn--primary:disabled { --btn-bg: var(--button-primary-bg-disabled); --btn-color: var(--button-primary-color-disabled); cursor: not-allowed; }

  .btn--primary:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  .btn--secondary { --btn-bg: var(--button-secondary-bg-default); --btn-color: var(--button-secondary-color-default); border: var(--button-borderWidth-secondary) solid var(--button-secondary-br); }
  .btn--secondary:hover { --btn-bg: var(--button-secondary-bg-hover); --btn-color: var(--button-secondary-color-hover); }
  .btn--secondary:active { --btn-bg: var(--button-secondary-bg-active); --btn-color: var(--button-secondary-color-active); }

  .btn--text { --btn-bg: var(--button-text-bg-default); --btn-color: var(--button-text-color-default); }
  .btn--text:hover { --btn-bg: var(--button-text-bg-hover); --btn-color: var(--button-text-color-hover); }
  .btn--text:active { --btn-bg: var(--button-text-bg-active); --btn-color: var(--button-text-color-active); }
</style>
