---
// Три карточки кейсів (Home і /cases). Третя — слот «coming soon» (пунктирна рамка, як плейсхолдер скріна).
import Icon from "./Icon.astro";
import Button from "./Button.astro";
import { href, t, type Locale } from "../i18n";

interface Props { lang: Locale }
const { lang } = Astro.props;
const d = t(lang);
const c = d.cases.items;
---
<ul class="cases">
  <li class="case">
    <span class="case__head"><Icon name="window" class="case__icon" /><span class="case__tag ts-label-sm">{c[0].tag}</span></span>
    <h3 class="case__title ts-title-t4">{c[0].title}</h3>
    <p class="case__detail ts-body-md-regular">{c[0].detail}</p>
    <Button variant="secondary" size="md" icon="arrowRight" class="case__cta" href={href(lang, "cases/aurum-multibrand")} data-event="case_aurum">{c[0].cta}</Button>
  </li>
  <li class="case">
    <span class="case__head"><Icon name="palette" class="case__icon" /><span class="case__tag ts-label-sm">{c[1].tag}</span></span>
    <h3 class="case__title ts-title-t4">{c[1].title}</h3>
    <p class="case__detail ts-body-md-regular">{c[1].detail}</p>
    <Button variant="secondary" size="md" icon="arrowRight" class="case__cta" href={href(lang, "approach")} data-event="case_site">{c[1].cta}</Button>
  </li>
  <li class="case case--soon">
    <span class="case__head"><Icon name="clock" class="case__icon" /><span class="case__tag ts-label-sm">{c[2].tag}</span></span>
    <h3 class="case__title ts-title-t4">{c[2].title}</h3>
    <p class="case__detail ts-body-md-regular">{c[2].detail}</p>
  </li>
</ul>

<style>
  .cases { display: grid; gap: var(--l-gap); }
  @media (min-width: 768px) { .cases { grid-template-columns: repeat(3, 1fr); } }
  .case { display: flex; flex-direction: column; align-items: flex-start; gap: var(--caseCard-gap); padding: var(--caseCard-padding); background: var(--caseCard-bg-default); border: var(--caseCard-borderWidth) solid var(--caseCard-br-default); border-radius: var(--caseCard-borderRadius); }
  .case:hover:not(.case--soon) { background: var(--caseCard-bg-hover); border-color: var(--caseCard-br-hover); }
  .case--soon { background: var(--shot-bg); border-style: dashed; border-color: var(--shot-br); }
  .case__tag { padding-inline: var(--caseCard-tag-paddingH); height: var(--caseCard-tag-size); display: inline-flex; align-items: center; background: var(--caseCard-tag-bg); color: var(--caseCard-tag-color); border-radius: var(--caseCard-tag-borderRadius); }
  .case__head { display: flex; align-items: center; gap: var(--space-gap-md); }
  .case__head :global(.case__icon) { --icon-size: var(--iconSize-lg); color: var(--caseCard-title-color); }
  .case__title { color: var(--caseCard-title-color); }
  .case__detail { color: var(--caseCard-detail-color); }
  .case :global(.case__cta) { margin-top: auto; }
</style>
