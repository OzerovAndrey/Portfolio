---
// Signature Work (Home, секція 03): «One system. Many brands.» Нативна експозиція — ОДИН інтерфейс, змонтований раз.
// Бренд і тема сцени — атрибути data-brand / data-theme на .xstage; усе решта — резолв токенів у scoped-CSS (npm run tokens:exhibit,
// src/generated/exhibit/exhibit.css ← tokens/brand/site.json, tokens/demo/**, дзеркальні theme). Жодних скрінів і заміни DOM.
// Колір бренду живе тільки в .xstage: керування й лінза — поза scope, тому решта сторінки лишається монохромною.
// Сцена aria-hidden + inert: усе змістовне (бренд, тема, цифри, шлях резолву токена) доступне поза нею.
import "../generated/exhibit/exhibit.css";
import { BRANDS, NEUTRAL, THEMES, TOKENS, facts, states } from "../lib/exhibit";
import { t, type Locale } from "../i18n";

interface Props { lang: Locale }
const d = t(Astro.props.lang);
const s = d.signature;
const st = s.stage;
const ex = d.architecture.explorer;
const BRAND_NAME: Record<string, string> = { aurum: "Aurum", nova: "Nova", fiesta: "Fiesta", ultra: "Ultra" };
const payload = {
  states,
  names: BRAND_NAME,
  neutral: NEUTRAL,
  i18n: { layerNames: ex.layerNames, notes: ex.notes, themes: s.controls.themes, neutral: s.controls.neutral, announce: s.announce },
};
const amount = { brandValues: String(facts.brandValues), componentTokens: String(facts.componentTokens), aliases: String(facts.aliasesChanged), matrix: `${facts.brands} × ${facts.themes}` };
---
<section class="section section--editorial signature" id="signature" aria-labelledby="signature-title" data-exhibit>
  <div class="container">
    <p class="signature__label ts-label-md"><span aria-hidden="true">03</span><span>{s.label}</span></p>
    <h2 class="signature__title ts-display-d2 display-lg measure--heading" id="signature-title">{s.title}</h2>
    <p class="signature__lead ts-body-lg-regular measure--lead lead">{s.lead}</p>

    <div class="exhibit">
      <!-- Керування: нативні radio (клавіатура й семантика безкоштовно). Жоден бренд не вибрано = нейтральний стан -->
      <div class="exhibit__controls" role="group" aria-label={s.controls.group}>
        <fieldset class="ctl">
          <legend class="ctl__legend ts-label-sm">{s.controls.brand}</legend>
          <div class="ctl__row">
            {BRANDS.map((b) => (
              <label class="ctl__item ts-label-md"><input type="radio" name="exhibit-brand" value={b} data-event={`exhibit_brand_${b}`} /><span>{BRAND_NAME[b]}</span></label>
            ))}
          </div>
          <button type="button" class="ctl__reset ts-label-sm" data-reset disabled>{s.controls.reset}</button>
        </fieldset>
        <fieldset class="ctl">
          <legend class="ctl__legend ts-label-sm">{s.controls.theme}</legend>
          <div class="ctl__row">
            {THEMES.map((th) => (
              <label class="ctl__item ts-label-md"><input type="radio" name="exhibit-theme" value={th} checked={th === "light"} data-event={`exhibit_theme_${th}`} /><span>{s.controls.themes[th]}</span></label>
            ))}
          </div>
        </fieldset>
      </div>

      <!-- Сцена: той самий DOM для всіх станів. Компонентні токени демо читаються зі scope .xstage -->
      <div class="xstage ts-body-md-regular" data-stage data-brand="site" data-theme="light" aria-hidden="true" inert>
        <div class="xs-header">
          <span class="xs-logo"><i class="xs-logo__icon" data-token="header.logo.iconColor"></i><span class="ts-title-t5">{st.logo}</span></span>
          <span class="xs-nav ts-label-md">
            {st.nav.map((n, i) => <span class:list={["xs-link", i === 0 && "xs-link--active"]}>{n}</span>)}
          </span>
          <span class="xs-balance ts-label-md"><i class="xs-balance__icon"></i>{st.balance}</span>
        </div>
        <div class="xs-body">
          <div class="xs-promo">
            <div class="xs-promo__text">
              <p class="xs-promo__title ts-title-t3">{st.promoTitle}</p>
              <p class="ts-body-md-regular">{st.promoText}</p>
            </div>
            <span class="xs-btn xs-btn--primary ts-label-md" data-token="button.primary.bg.default button.borderRadius">{st.promoAction}</span>
          </div>
          <div class="xs-chips ts-label-md">
            {st.chips.map((c, i) => <span class:list={["xs-chip", i === 1 && "xs-chip--selected"]}>{c}</span>)}
          </div>
          <div class="xs-tiles">
            {st.tiles.map((tile, i) => (
              <div class="xs-tile">
                <div class={`xs-tile__art xs-tile__art--${"abc"[i]}`}><i></i></div>
                <p class="ts-label-md xs-tile__title">{tile.title}</p>
                <p class="ts-body-sm-regular xs-tile__meta">{tile.meta}</p>
              </div>
            ))}
          </div>
          <div class="xs-card" data-token="card.default.bg">
            <p class="ts-title-t5 xs-card__title">{st.cardTitle}<span class="xs-badge ts-label-sm" data-token="badge.primary.bg">{st.badge}</span></p>
            <div class="xs-input" data-token="input.br.active">
              <span class="xs-input__label ts-label-sm">{st.inputLabel}</span>
              <span class="xs-input__field ts-body-md-regular">{st.inputValue}</span>
            </div>
            <div class="xs-actions">
              <span class="xs-btn xs-btn--primary ts-label-md" data-token="button.primary.bg.default button.borderRadius">{st.save}</span>
              <span class="xs-btn xs-btn--secondary ts-label-md">{st.cancel}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Лінза: перші факти + властивості бренду + шлях резолву вибраного токена -->
      <div class="exhibit__lens lens">
        <dl class="facts" aria-label={s.facts.title}>
          <div class="fact"><dt class="ts-body-sm-regular">{s.facts.brandValues}</dt><dd class="ts-display-d3">{amount.brandValues}</dd></div>
          <div class="fact"><dt class="ts-body-sm-regular">{s.facts.componentTokens}</dt><dd class="ts-display-d3">{amount.componentTokens}</dd></div>
          <div class="fact"><dt class="ts-body-sm-regular">{s.facts.aliases}</dt><dd class="ts-display-d3">{amount.aliases}</dd></div>
          <div class="fact"><dt class="ts-body-sm-regular">{s.facts.matrix}</dt><dd class="ts-display-d3">{amount.matrix}</dd></div>
        </dl>

        <h3 class="lens__title ts-title-t5">{s.lens.title}</h3>
        <fieldset class="ctl ctl--tokens">
          <legend class="ctl__legend ts-label-sm">{s.lens.tokenLabel}</legend>
          <div class="ctl__row ctl__row--wrap">
            {TOKENS.map((tk, i) => (
              <label class="ctl__item ctl__item--token ts-label-sm"><input type="radio" name="exhibit-token" value={tk} checked={i === 0} /><span>{tk}</span></label>
            ))}
          </div>
        </fieldset>
        <div class="path">
          <p class="ts-label-sm lens__sub">{s.lens.path}</p>
          <ol class="path__list" data-path></ol>
        </div>
        <div class="props">
          <p class="ts-label-sm lens__sub">{s.lens.props}</p>
          <ul class="props__list ts-body-sm-regular" data-props></ul>
          <p class="props__note ts-body-sm-regular">{s.lens.fontNote}</p>
        </div>
        <p class="sr-only" role="status" aria-live="polite" data-live></p>
      </div>
    </div>

    <script type="application/json" data-exhibit-data set:html={JSON.stringify(payload)} />
    <script type="application/json" data-exhibit-labels set:html={JSON.stringify({ props: s.lens, result: s.lens.result })} />
  </div>
</section>

<script>
  // Plain-скрипт без залежностей: перемикає атрибути сцени й оновлює лінзу. DOM сцени не перебудовується
  const root = document.querySelector<HTMLElement>("[data-exhibit]");
  if (root) {
    const stage = root.querySelector<HTMLElement>("[data-stage]")!;
    const data = JSON.parse(root.querySelector("[data-exhibit-data]")!.textContent!);
    const L = JSON.parse(root.querySelector("[data-exhibit-labels]")!.textContent!);
    const brandInputs = [...root.querySelectorAll<HTMLInputElement>('input[name="exhibit-brand"]')];
    const themeInputs = [...root.querySelectorAll<HTMLInputElement>('input[name="exhibit-theme"]')];
    const tokenInputs = [...root.querySelectorAll<HTMLInputElement>('input[name="exhibit-token"]')];
    const reset = root.querySelector<HTMLButtonElement>("[data-reset]")!;
    const live = root.querySelector<HTMLElement>("[data-live]")!;
    const pathEl = root.querySelector<HTMLElement>("[data-path]")!;
    const propsEl = root.querySelector<HTMLElement>("[data-props]")!;
    const html = document.documentElement;
    let themeExplicit = false;
    const siteTheme = () => (html.dataset.theme === "dark" ? "dark" : "light");
    const brand = () => brandInputs.find((i) => i.checked)?.value ?? data.neutral;
    const theme = () => themeInputs.find((i) => i.checked)!.value;
    const token = () => tokenInputs.find((i) => i.checked)!.value;
    const isColor = (v?: string) => !!v && /^#[0-9a-f]{3,8}$/i.test(v);
    const el = (tag: string, cls?: string, text?: string) => { const e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; };
    const swatch = (c: string) => { const i = el("i", "swatch"); i.style.setProperty("--c", c); i.setAttribute("aria-hidden", "true"); return i; };
    const noteText = (n?: string) => {
      if (!n) return "";
      const m = /^(lighten|darken) ([\d.]+)/.exec(n);
      if (m) return String(data.i18n.notes[m[1]]).replace("{p}", String(Math.round(parseFloat(m[2]) * 100)));
      return /step 500/.test(n) ? data.i18n.notes.base : n;
    };

    function renderPath(state: any) {
      const chain = state.chains[token()];
      pathEl.replaceChildren(
        ...chain.steps.map((s: any) => {
          const li = el("li", "path__step");
          li.append(el("span", "path__layer ts-overline-sm", data.i18n.layerNames[s.layer] ?? s.layer), el("code", "path__name ts-body-sm-strong", s.name));
          if (s.note) li.append(el("span", "path__note ts-body-xs-regular", noteText(s.note)));
          if (s.value && !s.ref) { const v = el("span", "path__value ts-body-sm-regular"); if (isColor(s.value)) v.append(swatch(s.value)); v.append(s.value); li.append(v); }
          return li;
        }),
        (() => { const li = el("li", "path__step path__step--result"); const v = el("span", "path__value ts-body-md-strong"); if (isColor(chain.value)) v.append(swatch(chain.value)); v.append(chain.value); li.append(el("span", "path__layer ts-overline-sm", L.result), v); return li; })(),
      );
    }
    function renderProps(state: any) {
      const row = (label: string, ...vals: (string | Node)[]) => { const li = el("li", "props__row"); li.append(el("span", "props__label", label)); const v = el("span", "props__vals"); v.append(...vals.map((x) => (typeof x === "string" ? el("span", undefined, x) : x))); li.append(v); return li; };
      const colors = Object.entries(state.colors).map(([k, c]) => { const w = el("span", "props__color"); w.append(swatch(c as string), `${k.replace("color.", "")} ${c}`); return w; });
      propsEl.replaceChildren(
        row(L.props.colors, ...colors),
        row(L.props.radius, `${L.props.control} ${state.radius.control}`, `${L.props.surface} ${state.radius.surface}`),
        row(L.props.fonts, `fontFamily.display · ${state.fonts.display}`, `fontFamily.base · ${state.fonts.base}`),
      );
    }
    function highlight() {
      const tk = token();
      stage.querySelectorAll("[data-hl]").forEach((n) => n.removeAttribute("data-hl"));
      stage.querySelectorAll("[data-token]").forEach((n) => { if ((n.getAttribute("data-token") ?? "").split(" ").includes(tk)) n.setAttribute("data-hl", ""); });
    }
    function apply(announce: boolean) {
      const b = brand(), th = theme();
      stage.dataset.brand = b; stage.dataset.theme = th;
      reset.disabled = b === data.neutral;
      const state = data.states[`${b}|${th}`];
      renderPath(state); renderProps(state); highlight();
      if (announce) {
        const themeName = data.i18n.themes[th];
        live.textContent = b === data.neutral ? data.i18n.announce.neutral.replace("{theme}", themeName) : data.i18n.announce.brand.replace("{brand}", data.names[b]).replace("{theme}", themeName);
      }
    }
    // Тема спершу = тема портфоліо й іде за нею; після явного вибору в експозиції — незалежна. Глобальну тему не чіпаємо
    const syncTheme = () => { if (!themeExplicit) { const th = siteTheme(); themeInputs.forEach((i) => (i.checked = i.value === th)); apply(false); } };
    brandInputs.forEach((i) => i.addEventListener("change", () => apply(true)));
    themeInputs.forEach((i) => i.addEventListener("change", () => { themeExplicit = true; apply(true); }));
    tokenInputs.forEach((i) => i.addEventListener("change", () => { const state = data.states[`${brand()}|${theme()}`]; renderPath(state); highlight(); }));
    reset.addEventListener("click", () => { brandInputs.forEach((i) => (i.checked = false)); apply(true); brandInputs[0].focus(); });
    new MutationObserver(syncTheme).observe(html, { attributes: true, attributeFilter: ["data-theme"] });
    syncTheme();
  }
</script>

<style>
  /* Каркас секції: індекс-рядок, твердження, lead — та сама мова, що в Positioning. Далі експозиція: сцена домінує, керування й лінза — другорядні */
  .signature__label { display: flex; align-items: baseline; gap: var(--space-gap-xl); padding-top: var(--space-padding-md); border-top: var(--borderWidth-control) solid var(--exhibit-rule-br); color: var(--exhibit-label-color); }
  .signature__title { margin-top: var(--section-gap); color: var(--exhibit-title-color); }
  .signature__lead { margin-top: var(--section-gap); color: var(--exhibit-text-color); }
  .exhibit { display: grid; gap: var(--l-gap); margin-top: calc(var(--layout-section-padding) * 0.6); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 1024px) {
    .exhibit { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); grid-template-areas: "stage controls" "stage lens"; align-items: start; }
    .exhibit__controls { grid-area: controls; }
    .xstage { grid-area: stage; }
    .exhibit__lens { grid-area: lens; }
  }

  /* ---------- керування (поза scope, монохром) ---------- */
  .exhibit__controls { display: grid; gap: var(--space-gap-xl); }
  .ctl { margin: 0; padding: 0; border: 0; min-width: 0; display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-gap-md); }
  .ctl__legend { padding: 0; color: var(--exhibit-label-color); width: 100%; }
  .ctl__row { display: flex; flex-wrap: wrap; gap: var(--space-gap-sm); }
  .ctl__row--wrap { gap: var(--space-gap-sm); }
  .ctl__item { position: relative; display: inline-flex; }
  .ctl__item input { position: absolute; inset: 0; margin: 0; opacity: 0; cursor: pointer; }
  .ctl__item span {
    display: inline-flex; align-items: center; min-height: var(--size-control-md); padding-inline: var(--space-padding-md); box-sizing: border-box;
    border: var(--action-borderWidth) solid var(--action-secondary-br-default); border-radius: var(--button-borderRadius);
    background: var(--action-secondary-bg-default); color: var(--action-secondary-color-default);
    transition: background-color var(--motion-duration-fast) var(--motion-easing-out), border-color var(--motion-duration-fast) var(--motion-easing-out);
  }
  .ctl__item--token span { min-height: var(--size-control-sm); padding-inline: var(--space-padding-sm); overflow-wrap: anywhere; }
  @media (hover: hover) { .ctl__item:hover span { background: var(--action-secondary-bg-hover); border-color: var(--action-secondary-br-hover); } }
  /* вибраний стан — інверсна заливка (не лише колір: ще й контраст заливки) */
  .ctl__item input:checked + span { background: var(--action-bg-default); border-color: var(--action-bg-default); color: var(--action-color-default); }
  .ctl__item input:focus-visible + span { outline: calc(var(--focus-outline-borderWidth) * 2) solid var(--action-focus-color); outline-offset: calc(var(--focus-outline-borderWidth) * 3); }
  .ctl__reset { border: 0; background: transparent; color: var(--exhibit-text-color); text-decoration: underline; text-underline-offset: 0.2em; cursor: pointer; padding: var(--space-gap-sm) 0; }
  .ctl__reset:disabled { color: var(--exhibit-label-color); text-decoration: none; cursor: default; }
  .ctl__reset:focus-visible { outline: calc(var(--focus-outline-borderWidth) * 2) solid var(--action-focus-color); outline-offset: calc(var(--focus-outline-borderWidth) * 2); }

  /* ---------- лінза ---------- */
  .lens { display: grid; gap: var(--space-gap-xl); min-width: 0; }
  .facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-gap-xl) var(--l-gap); margin: 0; }
  .fact { min-width: 0; display: flex; flex-direction: column-reverse; gap: var(--space-gap-sm); padding-top: var(--space-padding-md); border-top: var(--borderWidth-control) solid var(--exhibit-rule-br); }
  .fact dt { color: var(--exhibit-text-color); overflow-wrap: anywhere; }
  .fact dd { margin: 0; color: var(--exhibit-title-color); font-variant-numeric: tabular-nums; }
  .lens__title { color: var(--exhibit-title-color); }
  .lens__sub { color: var(--exhibit-label-color); margin-bottom: var(--space-gap-md); }
  .path__list { display: grid; gap: var(--space-gap-sm); }
  :global(.path__step) { display: grid; gap: var(--space-gap-xs); padding: var(--space-padding-sm) 0; border-top: var(--borderWidth-control) solid var(--exhibit-rule-br); min-width: 0; }
  :global(.path__layer), :global(.path__note) { color: var(--exhibit-label-color); }
  :global(.path__name) { color: var(--exhibit-title-color); overflow-wrap: anywhere; }
  :global(.path__value) { display: inline-flex; align-items: center; gap: var(--space-gap-sm); color: var(--exhibit-title-color); overflow-wrap: anywhere; }
  :global(.path__step--result .path__value) { color: var(--exhibit-title-color); }
  :global(.swatch) { display: inline-block; flex: none; width: var(--iconSize-sm); height: var(--iconSize-sm); background: var(--c); border: var(--borderWidth-control) solid var(--exhibit-rule-br); border-radius: var(--borderRadius-control); }
  .props__list { display: grid; gap: var(--space-gap-md); }
  :global(.props__row) { display: grid; gap: var(--space-gap-xs); color: var(--exhibit-text-color); }
  :global(.props__label) { color: var(--exhibit-label-color); }
  :global(.props__vals) { display: grid; gap: var(--space-gap-xs); overflow-wrap: anywhere; }
  :global(.props__color) { display: inline-flex; align-items: center; gap: var(--space-gap-sm); }
  .props__note { margin-top: var(--space-gap-md); color: var(--exhibit-label-color); }

  /* ---------- сцена: компоненти демо на scoped-токенах (.xstage[data-brand][data-theme]). Ніяких значень тут — лише var(--…) ---------- */
  .xstage {
    container-type: inline-size; overflow: hidden; display: flex; flex-direction: column; min-width: 0;
    background: var(--color-bg-primary); color: var(--color-text-primary);
    border: var(--borderWidth-control) solid var(--color-border-tertiary); border-radius: var(--borderRadius-surface);
  }
  /* перехід безпечних властивостей при зміні бренду / теми: без руху, без зміни розкладки; reduced motion — нижче */
  .xstage :is(.xs-header, .xs-body, .xs-link, .xs-balance, .xs-chip, .xs-promo, .xs-btn, .xs-tile__art, .xs-card, .xs-input, .xs-badge, i) {
    transition: background-color var(--motion-duration-slow) var(--motion-easing-standard), color var(--motion-duration-slow) var(--motion-easing-standard), border-color var(--motion-duration-slow) var(--motion-easing-standard), border-radius var(--motion-duration-slow) var(--motion-easing-standard);
  }
  .xstage, .xstage p { margin: 0; }
  .xs-header { display: flex; align-items: center; gap: var(--header-gap); padding: var(--header-paddingV-md) var(--header-paddingH-md); background: var(--header-bg); border-bottom: var(--header-borderWidth) solid var(--header-br); }
  .xs-logo { display: inline-flex; align-items: center; gap: var(--space-gap-md); color: var(--header-logo-color); }
  .xs-logo__icon { width: var(--header-logo-height); height: var(--header-logo-height); background: var(--header-logo-iconColor); border-radius: var(--borderRadius-control); }
  .xs-nav { display: flex; gap: var(--header-nav-gap); margin-inline-start: var(--space-gap-xl); min-width: 0; }
  .xs-link { padding: var(--header-link-paddingV) var(--header-link-paddingH); border-radius: var(--header-link-borderRadius); color: var(--color-text-primary); white-space: nowrap; } /* text.primary: header.link.color.default (text.secondary) дає 3.94 : 1 у Aurum light — tasks/demo-03 */
  .xs-link--active { background: var(--header-link-bg-hover); color: var(--color-text-primary); }
  .xs-balance { margin-inline-start: auto; display: inline-flex; align-items: center; gap: var(--balance-gap-md); padding-inline: var(--balance-paddingL-md) var(--balance-paddingL-sm); height: var(--size-control-sm); background: var(--balance-bg); color: var(--balance-color); border-radius: var(--balance-borderRadius); }
  .xs-balance__icon { width: var(--balance-iconSize-md); height: var(--balance-iconSize-md); border-radius: var(--borderRadius-pill); background: var(--balance-iconColor); }
  .xs-body { display: grid; gap: var(--space-gap-xl); padding: var(--space-padding-xl); background: var(--color-bg-primary); }
  .xs-promo { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: var(--promo-gap-md); padding: var(--promo-paddingV-md) var(--promo-paddingH-md); border-radius: var(--promo-borderRadius); position: relative; isolation: isolate; background: var(--art-jackpot-bg); color: var(--promo-text-color); }
  .xs-promo::before { content: ""; position: absolute; inset: 0; z-index: -1; border-radius: inherit; background: var(--promo-overlay-bg); }
  .xs-promo__text { display: grid; gap: var(--promo-gap-xs); min-width: 0; }
  .xs-promo__title { color: var(--promo-title-color); }
  .xs-chips { display: flex; flex-wrap: wrap; gap: var(--chip-gap); }
  /* неселектований чіп — стани hover (text.primary), бо default не проходить AA в частині брендів (tasks/demo-05); вибраний — selected.hover (onPrimary на fill.primary) */
