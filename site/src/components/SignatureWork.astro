---
// Signature Work (Home, секція 03): «One system. Many brands.» Нативна експозиція — ОДИН інтерфейс, змонтований раз.
// Бренд і тема сцени — атрибути data-brand / data-theme на .xstage; усе решта — резолв токенів у scoped-CSS (npm run tokens:exhibit,
// src/generated/exhibit/exhibit.css ← tokens/brand/site.json, tokens/demo/**, tokens/site/**, дзеркальні theme). Жодних скрінів і заміни DOM.
// Колір бренду живе тільки в .xstage: керування й лінза — поза scope, тому решта сторінки лишається монохромною.
// Сцена aria-hidden + inert: усе змістовне (бренд, тема, цифри, шлях резолву токена) доступне поза нею.
// Глибина: canvas → plate (.surface--raised) → stage (токени бренду) → картка / плитки → один фокусний шар .surface--glass-strong у промо.
import ProductStage from "./ProductStage.astro";
import BrandControls from "./BrandControls.astro";
import { BRAND_NAME, NEUTRAL, TOKENS, facts, states } from "../lib/exhibit";
import { t, type Locale } from "../i18n";

interface Props { lang: Locale }
const d = t(Astro.props.lang);
const s = d.signature;
const ex = d.architecture.explorer;
const payload = {
  states,
  names: BRAND_NAME,
  neutral: NEUTRAL,
  i18n: { layerNames: ex.layerNames, notes: ex.notes, themes: s.controls.themes, neutral: s.controls.neutral, announce: s.announce },
};
const amount = { brandValues: String(facts.brandValues), componentTokens: String(facts.componentTokens), aliases: String(facts.aliasesChanged), matrix: `${facts.brands} × ${facts.themes}` };
---
<section class="section section--editorial signature" id="signature" aria-labelledby="signature-title" data-exhibit>
  <div class="container">
    <p class="signature__label ts-label-md"><span aria-hidden="true">03</span><span>{s.label}</span></p>
    <h2 class="signature__title ts-display-d2 display-lg measure--heading" id="signature-title">{s.title}</h2>
    <p class="signature__lead ts-body-lg-regular measure--lead lead">{s.lead}</p>

    <!-- STEP 8A: головна інтерактивна сцена тепер у Hero. Тут — доказ-результат; повна експозиція з лінзою згорнута (розкриття — STEP 8B) -->
    <details class="inspect">
      <summary class="inspect__toggle ts-label-md" data-event="signature_inspect">{s.inspect}</summary>
    <div class="exhibit">
      <!-- Керування: «Neutral» — вихідний стан (site), решта — 4 бренди -->
      <BrandControls lang={Astro.props.lang} name="exhibit" brand={NEUTRAL} theme="light" neutral event="exhibit" class="exhibit__controls" />

      <!-- Plate: поверхня-основа експозиції (.surface--raised). Усередині — сцена: той самий DOM для всіх станів -->
      <div class="exhibit__plate surface surface--raised">
        <ProductStage lang={Astro.props.lang} brand={NEUTRAL} theme="light" />
      </div>

      <!-- Лінза: інспектор системи під продуктом — факти, вибір токена, шлях резолву, властивості файлу бренду -->
      <div class="exhibit__lens lens" data-lens>
        <dl class="facts" aria-label={s.facts.title}>
          <div class="fact"><dt class="ts-body-sm-regular">{s.facts.brandValues}</dt><dd class="ts-title-t1">{amount.brandValues}</dd></div>
          <div class="fact"><dt class="ts-body-sm-regular">{s.facts.componentTokens}</dt><dd class="ts-title-t1">{amount.componentTokens}</dd></div>
          <div class="fact"><dt class="ts-body-sm-regular">{s.facts.aliases}</dt><dd class="ts-title-t1">{amount.aliases}</dd></div>
          <div class="fact"><dt class="ts-body-sm-regular">{s.facts.matrix}</dt><dd class="ts-title-t1">{amount.matrix}</dd></div>
        </dl>

        <h3 class="lens__title ts-label-md">{s.lens.title}</h3>
        <fieldset class="toklist">
          <legend class="lens__sub ts-label-sm">{s.lens.tokenLabel}</legend>
          {TOKENS.map((tk, i) => (
            <label class="tok ts-body-sm-strong"><input type="radio" name="exhibit-token" value={tk} checked={i === 0} /><span>{tk}</span></label>
          ))}
        </fieldset>
        <div class="lens__block" data-swap>
          <p class="lens__sub ts-label-sm">{s.lens.path}</p>
          <ol class="trace" data-path></ol>
        </div>
        <p class="sr-only" role="status" aria-live="polite" data-live></p>
      </div>

      <!-- Що задає файл бренду: під продуктом (десктоп) — кольори, радіуси, шрифти як справжні токени -->
      <div class="exhibit__props" data-swap>
        <p class="lens__sub ts-label-sm">{s.lens.props}</p>
        <ul class="props ts-body-sm-regular" data-props></ul>
        <p class="props__note ts-body-xs-regular">{s.lens.fontNote}</p>
      </div>
    </div>
    </details>

    <script type="application/json" data-exhibit-data set:html={JSON.stringify(payload)} />
    <script type="application/json" data-exhibit-labels set:html={JSON.stringify({ props: s.lens, result: s.lens.result })} />
  </div>
</section>

<script>
  import { setStage } from "../lib/stage";
  // Plain-скрипт без залежностей: перемикає атрибути сцени й оновлює лінзу. DOM сцени не перебудовується
  const root = document.querySelector<HTMLElement>("[data-exhibit]");
  if (root) {
    const stage = root.querySelector<HTMLElement>("[data-stage]")!;
    const lens = root.querySelector<HTMLElement>(".exhibit")!;
    const data = JSON.parse(root.querySelector("[data-exhibit-data]")!.textContent!);
    const L = JSON.parse(root.querySelector("[data-exhibit-labels]")!.textContent!);
    const brandInputs = [...root.querySelectorAll<HTMLInputElement>('input[name="exhibit-brand"]')];
    const themeInputs = [...root.querySelectorAll<HTMLInputElement>('input[name="exhibit-theme"]')];
    const tokenInputs = [...root.querySelectorAll<HTMLInputElement>('input[name="exhibit-token"]')];
    const live = root.querySelector<HTMLElement>("[data-live]")!;
    const pathEl = root.querySelector<HTMLElement>("[data-path]")!;
    const propsEl = root.querySelector<HTMLElement>("[data-props]")!;
    const html = document.documentElement;
    let themeExplicit = false;
    const siteTheme = () => (html.dataset.theme === "dark" ? "dark" : "light");
    const brand = () => brandInputs.find((i) => i.checked)!.value;
    const theme = () => themeInputs.find((i) => i.checked)!.value;
    const token = () => tokenInputs.find((i) => i.checked)!.value;
    const isColor = (v?: string) => !!v && /^#[0-9a-f]{3,8}$/i.test(v);
    const el = (tag: string, cls?: string, text?: string) => { const e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; };
    const swatch = (c: string) => { const i = el("i", "swatch"); i.style.setProperty("--c", c); i.setAttribute("aria-hidden", "true"); return i; };
    const noteText = (n?: string) => {
      if (!n) return "";
      const m = /^(lighten|darken) ([\d.]+)/.exec(n);
      if (m) return String(data.i18n.notes[m[1]]).replace("{p}", String(Math.round(parseFloat(m[2]) * 100)));
      return /step 500/.test(n) ? data.i18n.notes.base : n;
    };

    function renderPath(state: any) {
      const chain = state.chains[token()];
      pathEl.replaceChildren(
        ...chain.steps.map((s: any) => {
          const li = el("li", "trace__step"); li.dataset.layer = s.layer;
          li.append(el("span", "trace__layer ts-overline-sm", data.i18n.layerNames[s.layer] ?? s.layer), el("code", "trace__name ts-body-sm-strong", s.name));
          if (s.note) li.append(el("span", "trace__note ts-body-xs-regular", noteText(s.note)));
          if (s.value && !s.ref) { const v = el("span", "trace__value ts-body-sm-regular"); if (isColor(s.value)) v.append(swatch(s.value)); v.append(s.value); li.append(v); }
          return li;
        }),
        (() => { const li = el("li", "trace__step trace__step--result"); const v = el("span", "trace__value ts-title-t5"); if (isColor(chain.value)) v.append(swatch(chain.value)); v.append(chain.value); li.append(el("span", "trace__layer ts-overline-sm", L.result), v); return li; })(),
      );
    }
    function renderProps(state: any) {
      const row = (label: string, ...vals: (string | Node)[]) => { const li = el("li", "props__row"); li.append(el("span", "props__label ts-label-sm", label)); const v = el("span", "props__vals"); v.append(...vals.map((x) => (typeof x === "string" ? el("span", undefined, x) : x))); li.append(v); return li; };
      const colors = Object.entries(state.colors).map(([k, c]) => { const w = el("span", "props__color"); w.append(swatch(c as string), `${k.replace("color.", "")} ${c}`); return w; });
      propsEl.replaceChildren(
        row(L.props.colors, ...colors),
        row(L.props.radius, `${L.props.control} ${state.radius.control}`, `${L.props.surface} ${state.radius.surface}`),
        row(L.props.fonts, `fontFamily.display · ${state.fonts.display}`, `fontFamily.base · ${state.fonts.base}`),
      );
    }
    function highlight() {
      const tk = token();
      stage.querySelectorAll("[data-hl]").forEach((n) => n.removeAttribute("data-hl"));
      stage.querySelectorAll("[data-token]").forEach((n) => { if ((n.getAttribute("data-token") ?? "").split(" ").includes(tk)) n.setAttribute("data-hl", ""); });
    }
    // Коротке «резолвиться» для лінзи: opacity-перехід (CSS), без руху розкладки; reduced motion — миттєво
    function resolving() { lens.classList.add("is-resolving"); requestAnimationFrame(() => requestAnimationFrame(() => lens.classList.remove("is-resolving"))); }
    function apply(announce: boolean) {
      const b = brand(), th = theme();
      setStage(stage, b, th);
      const state = data.states[`${b}|${th}`];
      renderPath(state); renderProps(state); highlight(); resolving();
      if (announce) {
        const themeName = data.i18n.themes[th];
        live.textContent = b === data.neutral ? data.i18n.announce.neutral.replace("{theme}", themeName) : data.i18n.announce.brand.replace("{brand}", data.names[b]).replace("{theme}", themeName);
      }
    }
    // Тема спершу = тема портфоліо й іде за нею; після явного вибору в експозиції — незалежна. Глобальну тему не чіпаємо
    const syncTheme = () => { if (!themeExplicit) { const th = siteTheme(); themeInputs.forEach((i) => (i.checked = i.value === th)); apply(false); } };
    brandInputs.forEach((i) => i.addEventListener("change", () => apply(true)));
    themeInputs.forEach((i) => i.addEventListener("change", () => { themeExplicit = true; apply(true); }));
    tokenInputs.forEach((i) => i.addEventListener("change", () => { renderPath(data.states[`${brand()}|${theme()}`]); highlight(); resolving(); }));
    new MutationObserver(syncTheme).observe(html, { attributes: true, attributeFilter: ["data-theme"] });
    syncTheme();
  }
</script>

<style>
  /* Каркас секції: індекс-рядок, твердження, lead — та сама мова, що в Positioning. Далі експозиція: Stage домінує, лінза — другорядна */
  .signature__label { display: flex; align-items: baseline; gap: var(--space-gap-xl); padding-top: var(--space-padding-md); border-top: var(--borderWidth-control) solid var(--exhibit-rule-br); color: var(--exhibit-label-color); }
  .signature__title { margin-top: var(--section-gap); color: var(--exhibit-title-color); }
  .signature__lead { margin-top: var(--section-gap); color: var(--exhibit-text-color); }
  .inspect { margin-top: calc(var(--layout-section-padding) * 0.4); border-top: var(--borderWidth-control) solid var(--exhibit-rule-br); }
  .inspect__toggle { display: flex; align-items: center; gap: var(--space-gap-md); min-height: var(--size-control-lg); cursor: pointer; color: var(--exhibit-title-color); list-style: none; }
  .inspect__toggle::-webkit-details-marker { display: none; }
  .inspect__toggle::after { content: "+"; margin-inline-start: auto; color: var(--exhibit-label-color); }
  .inspect[open] > .inspect__toggle::after { content: "−"; }
  .inspect__toggle:focus-visible { outline: calc(var(--focus-outline-borderWidth) * 2) solid var(--action-focus-color); outline-offset: calc(var(--focus-outline-borderWidth) * 2); }
  .exhibit { display: grid; gap: var(--l-gap); margin-top: var(--space-gap-xl); grid-template-columns: minmax(0, 1fr); }
  /* ≥ 1200: Stage ≈ 2/3 ширини, лінза праворуч; нижче — лінза під сценою у дві колонки */
  @media (min-width: 768px) { .lens { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--l-gap); } .facts { grid-column: 1 / -1; } .lens__title { grid-column: 1 / -1; } }
  @media (min-width: 1200px) {
    .exhibit { grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); grid-template-areas: "controls controls" "plate lens" "props lens"; align-items: start; }
    :global(.exhibit__controls) { grid-area: controls; }
    .exhibit__plate { grid-area: plate; }
    .exhibit__lens { grid-area: lens; }
    .exhibit__props { grid-area: props; }
    .lens { grid-template-columns: minmax(0, 1fr); }
  }


  .exhibit__props { min-width: 0; padding-top: var(--space-padding-md); border-top: var(--borderWidth-control) solid var(--exhibit-rule-br); }
  @media (min-width: 768px) { .props { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--l-gap); } }
  /* ---------- plate: основа експозиції ---------- */
  .exhibit__plate { padding: var(--space-padding-md); border-radius: var(--borderRadius-panel); min-width: 0; }

  /* ---------- лінза: інспектор під продуктом ---------- */
  .lens { display: grid; gap: var(--space-gap-xl); min-width: 0; align-content: start; }
  .lens__title { color: var(--exhibit-title-color); text-transform: none; margin-top: var(--space-gap-md); padding-top: var(--space-padding-md); border-top: var(--borderWidth-control) solid var(--exhibit-rule-br); }
  .lens__sub { color: var(--exhibit-label-color); margin-bottom: var(--space-gap-md); }
  .lens__block { min-width: 0; }
  .facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-gap-xl) var(--l-gap); margin: 0; }
  .fact { min-width: 0; display: flex; flex-direction: column-reverse; gap: var(--space-gap-xs); padding-top: var(--space-padding-sm); border-top: var(--borderWidth-control) solid var(--exhibit-rule-br); }
  .fact dt { color: var(--exhibit-text-color); overflow-wrap: anywhere; }
  .fact dd { margin: 0; color: var(--exhibit-title-color); font-variant-numeric: tabular-nums; }
  /* вибір токена: компактний список (радіо), вибраний — смужка + колір */
  .toklist { margin: 0; padding: 0; border: 0; min-width: 0; display: grid; align-content: start; grid-template-columns: repeat(auto-fit, minmax(min(100%, 30ch), 1fr)); column-gap: var(--space-gap-md); }
  .toklist .lens__sub { padding: 0; grid-column: 1 / -1; }
  .toklist legend { float: none; }
  .tok { position: relative; display: block; }
  .tok input { position: absolute; inset: 0; margin: 0; opacity: 0; cursor: pointer; }
  .tok span { display: block; padding: var(--space-gap-sm) var(--space-gap-lg); border-inline-start: calc(var(--borderWidth-control) * 2) solid transparent; color: var(--exhibit-label-color); overflow-wrap: break-word; transition: color var(--motion-duration-fast) var(--motion-easing-out), background-color var(--motion-duration-fast) var(--motion-easing-out); }
  @media (hover: hover) { .tok:hover span { color: var(--exhibit-text-color); } }
  .tok input:checked + span { color: var(--exhibit-title-color); border-inline-start-color: var(--exhibit-title-color); }
  .tok input:focus-visible + span { outline: calc(var(--focus-outline-borderWidth) * 2) solid var(--action-focus-color); outline-offset: calc(var(--focus-outline-borderWidth) * 2); }
  /* шлях резолву: вертикальна «траса» з вузлами; динамічні вузли — :global (їх створює скрипт) */
  .trace { display: grid; margin: 0; padding-inline-start: var(--space-padding-sm); border-inline-start: var(--borderWidth-control) solid var(--exhibit-rule-br); }
  :global(.trace__step) { position: relative; display: grid; gap: var(--space-gap-xs); padding: var(--space-gap-md) 0 var(--space-gap-md) var(--space-padding-md); min-width: 0; }
  :global(.trace__step)::before { content: ""; position: absolute; inset-inline-start: calc(var(--space-padding-sm) * -1 - var(--borderWidth-control) - var(--iconSize-xs) / 2 + var(--borderWidth-control) / 2); top: calc(var(--space-gap-md) + var(--space-gap-xs)); width: var(--iconSize-xs); height: var(--iconSize-xs); box-sizing: border-box; border-radius: var(--borderRadius-pill); background: var(--exhibit-rule-br); border: var(--borderWidth-control) solid var(--exhibit-label-color); }
  :global(.trace__step--result .trace__value) { color: var(--exhibit-title-color); }
  :global(.trace__step--result)::before { background: var(--exhibit-title-color); border-color: var(--exhibit-title-color); }
  :global(.trace__layer), :global(.trace__note) { color: var(--exhibit-label-color); }
  :global(.trace__name) { color: var(--exhibit-text-color); overflow-wrap: anywhere; }
  :global(.trace__step[data-layer="brand"] .trace__name), :global(.trace__step--result .trace__name) { color: var(--exhibit-title-color); }
  :global(.trace__value) { display: inline-flex; align-items: center; gap: var(--space-gap-sm); color: var(--exhibit-text-color); overflow-wrap: anywhere; }
  :global(.swatch) { display: inline-block; flex: none; width: var(--iconSize-sm); height: var(--iconSize-sm); background: var(--c); border: var(--borderWidth-control) solid var(--exhibit-rule-br); border-radius: var(--borderRadius-control); }
  .props { display: grid; gap: var(--space-gap-md); margin: 0; align-items: start; }
  :global(.props__row) { display: grid; align-content: start; gap: var(--space-gap-xs); color: var(--exhibit-text-color); }
  :global(.props__label) { color: var(--exhibit-label-color); }
  :global(.props__vals) { display: flex; flex-wrap: wrap; gap: var(--space-gap-xs) var(--space-gap-xl); overflow-wrap: anywhere; }
  :global(.props__color) { display: inline-flex; align-items: center; gap: var(--space-gap-sm); }
  .props__note { margin-top: var(--space-gap-md); max-width: var(--layout-measure-body); color: var(--exhibit-label-color); }
  /* «резолвиться»: короткий opacity-перехід тільки в лінзі, без руху розкладки */
  .exhibit [data-swap] { transition: opacity var(--motion-duration-base) var(--motion-easing-out); }
  .exhibit.is-resolving [data-swap] { opacity: 0.4; transition: none; }

  @media (prefers-reduced-motion: reduce) {
    .tok span, .exhibit [data-swap] { transition: none; }
  }
  @media (max-width: 359px) { .facts { grid-template-columns: minmax(0, 1fr); } }
</style>
