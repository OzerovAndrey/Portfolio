---
// Продуктова сцена — ОДИН інтерфейс на демо-компонентах. Бренд і тема — лише атрибути data-brand / data-theme на .xstage;
// кольори, шрифти, радіуси резолвить згенерований scoped-CSS (src/generated/exhibit/exhibit.css, npm run tokens:exhibit).
// Використовують Hero і Signature Work — той самий DOM і ті самі стилі; перемикає атрибути lib/stage.ts.
// Сцена aria-hidden + inert: це ілюстрація, керування й оголошення стану — поза нею.
import "../generated/exhibit/exhibit.css";
import { t, type Locale } from "../i18n";

interface Props { lang: Locale; brand: string; theme: "light" | "dark" }
const { lang, brand, theme } = Astro.props;
const st = t(lang).signature.stage;
---
<div class="xstage ts-body-md-regular" data-stage data-brand={brand} data-theme={theme} aria-hidden="true" inert>
  <div class="xs-header">
    <span class="xs-logo"><i class="xs-logo__icon" data-token="header.logo.iconColor"></i><span class="ts-title-t5">{st.logo}</span></span>
    <span class="xs-nav ts-label-md">
      {st.nav.map((n, i) => <span class:list={["xs-link", i === 0 && "xs-link--active"]}>{n}</span>)}
    </span>
    <span class="xs-balance ts-label-md"><i class="xs-balance__icon"></i>{st.balance}</span>
  </div>
  <div class="xs-body">
    <div class="xs-promo">
      <div class="xs-promo__bar surface surface--glass-strong">
        <div class="xs-promo__text">
          <p class="xs-promo__title ts-title-t3">{st.promoTitle}</p>
          <p class="ts-body-md-regular">{st.promoText}</p>
        </div>
        <span class="xs-btn xs-btn--primary ts-label-md" data-token="button.primary.bg.default button.borderRadius">{st.promoAction}</span>
      </div>
    </div>
    <div class="xs-collection">
      <div class="xs-section">
        <p class="xs-section__title ts-title-t4">{st.sectionTitle}</p>
        <div class="xs-chips ts-label-md">
          {st.chips.map((c, i) => <span class:list={["xs-chip", i === 1 && "xs-chip--selected"]}>{c}</span>)}
        </div>
      </div>
      <div class="xs-tiles">
        {st.tiles.map((tile, i) => (
          <div class="xs-tile">
            <div class={`xs-tile__art xs-tile__art--${"abc"[i]}`}><i></i>{i === 0 && <span class="xs-badge xs-badge--neutral ts-label-sm">{st.badge}</span>}</div>
            <p class="ts-label-md xs-tile__title">{tile.title}</p>
            <p class="ts-body-sm-regular xs-tile__meta">{tile.meta}</p>
          </div>
        ))}
      </div>
    </div>
    <div class="xs-card" data-token="card.default.bg">
      <p class="ts-title-t5 xs-card__title">{st.cardTitle}<span class="xs-badge ts-label-sm" data-token="badge.primary.bg">{st.badge}</span></p>
      <div class="xs-input" data-token="input.br.active">
        <span class="xs-input__label ts-label-sm">{st.inputLabel}</span>
        <span class="xs-input__field ts-body-md-regular">{st.inputValue}</span>
      </div>
      <div class="xs-actions">
        <span class="xs-btn xs-btn--primary ts-label-md" data-token="button.primary.bg.default button.borderRadius">{st.save}</span>
        <span class="xs-btn xs-btn--secondary ts-label-md">{st.cancel}</span>
      </div>
    </div>
  </div>
</div>

<style>
  /* ---------- сцена: компоненти демо на scoped-токенах (.xstage[data-brand][data-theme]). Ніяких значень тут — лише var(--…) ---------- */
  .xstage {
    container-type: inline-size; overflow: hidden; display: flex; flex-direction: column; min-width: 0;
    background: var(--color-bg-primary); color: var(--color-text-primary);
    border: var(--borderWidth-control) solid var(--color-border-tertiary); border-radius: var(--borderRadius-surface);
  }
  /* перехід безпечних властивостей при зміні бренду / теми: колір, рамка, радіус; без руху й зміни розкладки */
  .xstage :is(.xs-header, .xs-body, .xs-link, .xs-balance, .xs-chip, .xs-promo, .xs-promo__bar, .xs-btn, .xs-tile__art, .xs-card, .xs-input__field, .xs-badge, i) {
    transition: background-color var(--motion-duration-slow) var(--motion-easing-standard), color var(--motion-duration-slow) var(--motion-easing-standard), border-color var(--motion-duration-slow) var(--motion-easing-standard), border-radius var(--motion-duration-slow) var(--motion-easing-standard);
  }
  .xstage, .xstage p { margin: 0; }
  .xs-header { display: flex; align-items: center; gap: var(--header-gap); padding: var(--header-paddingV-md) var(--header-paddingH-md); background: var(--header-bg); border-bottom: var(--header-borderWidth) solid var(--header-br); }
  .xs-logo { display: inline-flex; align-items: center; gap: var(--space-gap-md); color: var(--header-logo-color); }
  .xs-logo__icon { width: var(--header-logo-height); height: var(--header-logo-height); background: var(--header-logo-iconColor); border-radius: var(--borderRadius-control); }
  .xs-nav { display: flex; gap: var(--header-nav-gap); margin-inline-start: var(--space-gap-xl); min-width: 0; }
  .xs-link { padding: var(--header-link-paddingV) var(--header-link-paddingH); border-radius: var(--header-link-borderRadius); color: var(--color-text-primary); white-space: nowrap; } /* text.primary: header.link.color.default (text.secondary) дає 3.94 : 1 у Aurum light — tasks/demo-03 */
  .xs-link--active { background: var(--header-link-bg-hover); }
  .xs-balance { margin-inline-start: auto; display: inline-flex; align-items: center; gap: var(--balance-gap-md); padding-inline: var(--balance-paddingL-md) var(--balance-paddingL-sm); height: var(--size-control-sm); background: var(--balance-bg); color: var(--balance-color); border-radius: var(--balance-borderRadius); }
  .xs-balance__icon { width: var(--balance-iconSize-md); height: var(--balance-iconSize-md); border-radius: var(--borderRadius-pill); background: var(--balance-iconColor); }
  .xs-body { display: grid; gap: var(--space-gap-xl); padding: var(--space-padding-md); grid-template-columns: minmax(0, 1fr); background: var(--color-bg-primary); }
  /* промо: фон — ілюстраційна сцена бренду (art.jackpot), затемнення bg.overlay, зверху — фокусний шар glass-strong. Без декоративних форм: висота = вміст */
  .xs-promo { position: relative; isolation: isolate; overflow: hidden; display: flex; align-items: end; padding: var(--space-padding-md); border-radius: var(--promo-borderRadius); background: var(--art-jackpot-bg); }
  .xs-promo::before { content: ""; position: absolute; inset: 0; z-index: -2; border-radius: inherit; background: var(--promo-overlay-bg); }
  .xs-promo__bar { position: relative; z-index: 1; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-gap-xl); width: 100%; box-sizing: border-box; padding: var(--space-padding-md); border-radius: var(--promo-borderRadius); color: var(--color-text-primary); }
  .xs-promo__text { display: grid; gap: var(--space-gap-xs); min-width: 0; }
  .xs-promo__title { color: var(--color-text-primary); }
  .xs-collection { display: grid; gap: var(--space-gap-xl); min-width: 0; align-content: start; }
  .xs-section { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-gap-md) var(--space-gap-xl); }
  .xs-section__title { color: var(--sectionHeader-title-color); }
  .xs-chips { display: flex; flex-wrap: wrap; gap: var(--chip-gap); }
  /* неселектований чіп — стани hover (text.primary), бо default не проходить AA в частині брендів (tasks/demo-05); вибраний — selected.hover (onPrimary на fill.primary) */
  .xs-chip { display: inline-flex; align-items: center; height: var(--chip-size-md); padding-inline: var(--chip-paddingH-md); border-radius: var(--chip-borderRadius); border: var(--borderWidth-control) solid var(--chip-br-hover); background: var(--chip-bg-hover); color: var(--chip-color-hover); }
  .xs-chip--selected { background: var(--chip-selected-bg-hover); border-color: var(--chip-selected-br-hover); color: var(--chip-selected-color-hover); }
  .xs-tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gameTile-gap); }
  .xs-tile { display: grid; gap: var(--gameTile-info-gap); align-content: start; min-width: 0; }
  .xs-tile__art { position: relative; display: grid; place-items: center; aspect-ratio: 4 / 3; border-radius: var(--gameTile-borderRadius); }
  .xs-tile__art--a { background: var(--art-a-bg); } .xs-tile__art--b { background: var(--art-b-bg); } .xs-tile__art--c { background: var(--art-c-bg); }
  .xs-tile__art i { width: var(--size-control-md); height: var(--size-control-md); border-radius: var(--borderRadius-control); background: var(--color-fill-primary-default); }
  .xs-tile__art .xs-badge { position: absolute; inset-block-start: var(--space-gap-md); inset-inline-start: var(--space-gap-md); }
  .xs-tile__title { color: var(--gameTile-title-color); }
  .xs-tile__meta { color: var(--color-text-primary); } /* text.secondary дає 3.94 : 1 у Aurum light */
  /* однорядкові підписи: шрифти брендів різної ширини не міняють висоту сцени між станами */
  .xs-tile__title, .xs-tile__meta, .xs-btn { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
  .xs-card { display: grid; grid-template-columns: minmax(0, 1fr); min-width: 0; gap: var(--card-default-gap-sm); align-content: start; padding: var(--card-default-paddingV-md) var(--card-default-paddingH-md); background: var(--card-default-bg); border: var(--card-default-borderWidth) solid var(--card-default-br); border-radius: var(--card-default-borderRadius); }
  .xs-card__title { display: flex; align-items: center; gap: var(--space-gap-md); color: var(--color-text-primary); }
  .xs-badge { display: inline-flex; align-items: center; height: var(--badge-size); padding-inline: var(--badge-paddingH); border-radius: var(--badge-borderRadius); background: var(--badge-primary-bg); color: var(--badge-primary-color); }
  .xs-badge--neutral { background: var(--badge-neutral-bg); color: var(--color-text-primary); /* allow: demo-токен badge.neutral.color у Aurum light ≈3.3:1 (tasks/demo-03) — беремо text.primary */ }
  .xs-input { display: grid; gap: var(--input-wrapper-gap); }
  .xs-input__label { color: var(--color-text-primary); } /* input.label (text.secondary) дає 4.18 : 1 у Aurum light */
  .xs-input__field { display: flex; align-items: center; height: var(--input-size-md); padding-inline: var(--input-paddingH-md); background: var(--input-bg-active); border: var(--input-borderWidth) solid var(--input-br-active); border-radius: var(--input-borderRadius); color: var(--input-color-active); min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .xs-actions { display: flex; flex-wrap: wrap; gap: var(--space-gap-md); min-width: 0; }
  .xs-btn { display: inline-flex; align-items: center; justify-content: center; height: var(--button-size-md); padding-inline: var(--button-paddingH-md); border-radius: var(--button-borderRadius); border: var(--button-borderWidth-secondary) solid transparent; }
  .xs-btn--primary { background: var(--button-primary-bg-default); color: var(--button-primary-color-default); }
  .xs-btn--secondary { background: var(--button-secondary-bg-default); color: var(--button-secondary-color-default); }
  /* підсвітка елементів, що відповідають вибраному токену лінзи (обведення — форма, не лише колір) */
  .xstage [data-hl] { outline: var(--focus-outline-borderWidth) solid var(--color-text-primary); outline-offset: calc(var(--focus-outline-borderWidth) * 3); }
  /* широка сцена: промо на всю ширину, нижче колекція зліва й картка справа */
  @container (min-width: 600px) { /* allow: брейкпоінт контейнера */
    .xs-body { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: var(--space-padding-xl); padding: var(--space-padding-xl); align-items: start; }
    .xs-promo { grid-column: 1 / -1; padding: var(--space-padding-xl); }
    .xs-promo__title { font-size: var(--fontSize-28); line-height: var(--lineHeight-36); }
    .xs-tile__art { aspect-ratio: 1 / 1; }
    .xs-promo__bar { padding: var(--space-padding-lg) var(--space-padding-xl); }
    .xs-collection { grid-column: 1; }
    .xs-card { grid-column: 2; }
  }
  /* вузька сцена: чотири чіпи не вміщаються в усіх шрифтах брендів — зайві ховаємо, щоб висота не стрибала між брендами; меню ховаємо */
  @container (max-width: 520px) { .xs-nav { display: none; } .xs-chip:nth-child(4) { display: none; } } /* allow: брейкпоінт контейнера */
  @container (max-width: 380px) { .xs-chip:nth-child(3) { display: none; } } /* allow: брейкпоінт контейнера */
  @media (prefers-reduced-motion: reduce) {
    .xstage :is(.xs-header, .xs-body, .xs-link, .xs-balance, .xs-chip, .xs-promo, .xs-promo__bar, .xs-btn, .xs-tile__art, .xs-card, .xs-input__field, .xs-badge, i) { transition: none; }
  }
</style>
