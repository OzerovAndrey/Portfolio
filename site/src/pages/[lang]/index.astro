---
import Base from "../../layouts/Base.astro";
import Button from "../../components/Button.astro";
import DemoFrame from "../../components/DemoFrame.astro";
import Architecture from "../../components/Architecture.astro";
import HeroStage from "../../components/HeroStage.astro";
import { href, staticLangPaths, t, type Locale } from "../../i18n";

export const getStaticPaths = staticLangPaths;
const lang = Astro.params.lang as Locale;
const d = t(lang);
// H1 по реченнях — для появи рядок за рядком. Текст той самий, що в i18n
const titleLines = d.hero.title.split(/(?<=[.!?])\s+/);
---
<Base lang={lang} page="home" title={d.meta.homeTitle} description={d.meta.homeDescription}>
  <section class="hero" data-hero>
    <div class="container hero__inner">
      <div class="hero__copy" data-hero-copy>
        <p class="hero__eyebrow ts-overline-md">{d.hero.eyebrow}</p>
        <h1 class="hero__title ts-display-d1">{titleLines.map((line, i) => <><span class="hero__line" style={`--i: ${i}`}>{line}</span>{i < titleLines.length - 1 && " "}</>)}</h1>
        <p class="hero__subtitle ts-body-lg-regular measure">{d.hero.subtitle}</p>
        <div class="hero__actions">
          <Button size="lg" href="#demo" data-event="cta_demo">{d.hero.ctaDemo}</Button>
          <Button size="lg" variant="glass" href="#how">{d.hero.ctaHow}</Button>
        </div>
      </div>
      <HeroStage lang={lang} />
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="metrics-title">
    <div class="container">
      <h2 class="sr-only" id="metrics-title">{d.metrics.title}</h2>
      <ul class="metrics">
        {d.metrics.items.map((m) => (
          <li class="metric">
            <span class="metric__amount ts-display-d2">{m.amount}</span>
            <span class="metric__label ts-body-md-regular">{m.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--alt" id="demo" aria-labelledby="demo-title">
    <div class="container">
      <div class="section__head">
        <p class="section__eyebrow ts-overline-md">{d.demo.eyebrow}</p>
        <h2 class="section__title ts-title-t1" id="demo-title">{d.demo.title}</h2>
      </div>
      <div class="demo-light"><DemoFrame lang={lang} /></div>
    </div>
  </section>


  <section class="section" id="architecture" aria-labelledby="architecture-title">
    <div class="container">
      <div class="section__head">
        <p class="section__eyebrow ts-overline-md">{d.architecture.eyebrow}</p>
        <h2 class="section__title ts-title-t1" id="architecture-title">{d.architecture.title}</h2>
        <p class="section__lead ts-body-lg-regular measure">{d.architecture.lead}</p>
      </div>
      <Architecture lang={lang} />
    </div>
  </section>

  <section class="section section--alt" id="how" aria-labelledby="how-title">
    <div class="container">
      <div class="section__head">
        <p class="section__eyebrow ts-overline-md">{d.how.eyebrow}</p>
        <h2 class="section__title ts-title-t1" id="how-title">{d.how.title}</h2>
      </div>
      <ol class="steps">
        {d.how.steps.map((s, i) => (
          <li class="step">
            <span class="step__index ts-label-lg" aria-hidden="true">{i + 1}</span>
            <h3 class="step__title ts-title-t4">{s.title}</h3>
            <p class="step__detail ts-body-md-regular">{s.detail}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>


  <section class="section" id="audience" aria-labelledby="audience-title">
    <div class="container">
      <div class="section__head">
        <p class="section__eyebrow ts-overline-md">{d.audience.eyebrow}</p>
        <h2 class="section__title ts-title-t1" id="audience-title">{d.audience.title}</h2>
      </div>
      <ul class="audience">
        {d.audience.items.map((a) => (
          <li class="audience__item">
            <h3 class="audience__title ts-title-t4">{a.title}</h3>
            <p class="audience__detail ts-body-md-regular">{a.detail}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="cta-title">
    <div class="container">
      <div class="cta">
        <div class="cta__text">
          <h2 class="cta__title ts-title-t2" id="cta-title">{d.cta.title}</h2>
          <p class="cta__lead ts-body-lg-regular measure">{d.cta.lead}</p>
        </div>
        <Button size="lg" href={href(lang, "contact")} data-event="cta_contact">{d.cta.button}</Button>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero компактний: висота = вміст (≤ одного екрана на desktop), без pin і скролу. Метрики йдуть одразу під ним.
     Контейнер ширший за звичайний (56 × 24 = 1344 проти 1232), щоб великий H1 і лобі-мокап стали поруч.
     overflow-x: clip — світло за мокапом не дає горизонтального скролу */
  .hero { background: var(--hero-bg); padding-block: var(--l-gap) var(--l-row); overflow-x: clip; }
  .hero__inner { display: flex; flex-direction: column; gap: var(--l-row); }
  @media (min-width: 900px) { .hero__inner { max-width: calc(var(--size-control-xl) * 24 + var(--l-padH) * 2); } }
  .hero__copy { display: flex; flex-direction: column; align-items: flex-start; gap: var(--hero-gap); }
  .hero__eyebrow { color: var(--hero-eyebrow-color); }
  .hero__title {
    color: var(--hero-title-color); max-width: 14ch; text-wrap: balance; hyphens: auto;
    font-size: var(--hero-title-fontSize); line-height: var(--hero-title-lineHeight); letter-spacing: var(--hero-title-letterSpacing);
  }
  .hero__subtitle { color: var(--hero-subtitle-color); font-size: var(--hero-subtitle-fontSize); line-height: var(--hero-subtitle-lineHeight); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--hero-actions-gap); margin-top: var(--space-gap-md); }
  /* Вузькі екрани: CTA завжди стовпчиком. Інакше перенос кнопок залежить від шрифту, і підміна fallback → Inter
     зсуває все нижче (CLS 0.10 на 412 px) */
  @media (max-width: 559px) { .hero__actions { flex-direction: column; align-items: stretch; align-self: stretch; } }

  /* Поява: рядки H1 → sub → CTA → мокап. Тільки transform і opacity; старт з opacity 0.04 — інакше LCP чекав кінця анімації */
  .hero__line { display: block; }
  @keyframes hero-rise { from { opacity: var(--motion-reveal-opacity); transform: translateY(var(--space-gap-xl)); } }
  /* Підзаголовок — LCP-елемент (найбільший текстовий блок): тільки зсув, без прозорості, щоб LCP не чекав анімації */
  @keyframes hero-rise-y { from { transform: translateY(var(--space-gap-xl)); } }
  @media (prefers-reduced-motion: no-preference) {
    .hero__line { animation: hero-rise var(--motion-duration-scene) var(--motion-easing-emphasized) both; animation-delay: calc(var(--motion-duration-fast) * var(--i)); }
    .hero__subtitle, .hero__actions, .hero :global(.hero__stage) { animation: hero-rise var(--motion-duration-scene) var(--motion-easing-emphasized) both; }
    .hero__subtitle { animation-name: hero-rise-y; animation-delay: calc(var(--motion-duration-fast) * 2); }
    .hero__actions { animation-delay: calc(var(--motion-duration-fast) * 3); }
    .hero :global(.hero__stage) { animation-delay: calc(var(--motion-duration-fast) * 4); }
  }
  @media (min-width: 900px) {
    .hero__inner { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); column-gap: var(--l-row); align-items: center; }
  }

  .steps { display: grid; gap: var(--l-gap); }
  @media (min-width: 768px) { .steps { grid-template-columns: repeat(3, 1fr); } }
  .step { display: flex; flex-direction: column; gap: var(--step-gap); }
  .step__index { display: inline-grid; place-items: center; width: var(--step-index-size); height: var(--step-index-size); border-radius: var(--step-index-borderRadius); background: var(--step-index-bg); color: var(--step-index-color); }
  .step__title { color: var(--step-title-color); }
  .step__detail { color: var(--step-detail-color); }

  .cta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--ctaBand-gap); padding: var(--ctaBand-padding); background: var(--ctaBand-bg); border: var(--ctaBand-borderWidth) solid var(--ctaBand-br); border-radius: var(--ctaBand-borderRadius); }
  .cta__text { display: flex; flex-direction: column; gap: var(--space-gap-md); }
  .cta__title { color: var(--ctaBand-title-color); }
  .cta__lead { color: var(--ctaBand-lead-color); }

  .section--tight { padding-block: var(--l-row); }
  .metrics { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--l-gap); }
  @media (min-width: 1024px) { .metrics { grid-template-columns: repeat(4, 1fr); } }
  .metric { display: flex; flex-direction: column; gap: var(--metric-gap); padding: var(--metric-padding); background: var(--metric-bg); border: var(--metric-borderWidth) solid var(--metric-br); border-radius: var(--metric-borderRadius); }
  .metric__amount { color: var(--metric-amount-color); }
  .metric, .audience__item { transition: border-color var(--motion-duration-fast) var(--motion-easing-out); }
  .metric:hover { border-color: var(--metric-hover-br); }
  .audience__item:hover { border-color: var(--audience-hover-br); }
  /* Живе демо в рамці, як лобі в hero: м'яке світло за рамкою (сам iframe не чіпаємо) */
  .demo-light { position: relative; }
  .demo-light::before { content: ""; position: absolute; inset: calc(var(--l-row) * -1) calc(var(--l-gap) * -1); pointer-events: none; background: radial-gradient(closest-side, var(--demoLight-bg), transparent); }
  .metric__label { color: var(--metric-label-color); }
  /* Вузькі екрани: одна колонка, число зліва від підпису — підпис не ламається у стовпчик */
  @media (max-width: 559px) {
    .metrics { grid-template-columns: 1fr; gap: var(--space-gap-md); }
    .metric { flex-direction: row; align-items: center; gap: var(--l-gap); }
    .metric__amount { min-width: 2ch; }
  }

  .audience { display: grid; gap: var(--l-gap); }
  @media (min-width: 768px) { .audience { grid-template-columns: repeat(3, 1fr); } }
  .audience__item { display: flex; flex-direction: column; gap: var(--audience-gap); padding: var(--audience-padding); background: var(--audience-bg); border: var(--audience-borderWidth) solid var(--audience-br); border-radius: var(--audience-borderRadius); }
  .audience__title { color: var(--audience-title-color); }
  .audience__detail { color: var(--audience-detail-color); }
</style>
