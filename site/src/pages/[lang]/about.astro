---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { staticLangPaths, t, type Locale } from "../../i18n";

export const getStaticPaths = staticLangPaths;
const lang = Astro.params.lang as Locale;
const d = t(lang);
const a = d.about;
const ICON = ["image", "briefcase", "wrench", "target", "mail"] as const; // фото · досвід · інструменти · принципи · контакти
---
<Base lang={lang} page="about" title={d.meta.aboutTitle} description={d.meta.aboutDescription}>
  <section class="section">
    <div class="container stack">
      <div class="section__head">
        <h1 class="section__title ts-display-d3">{a.title}</h1>
        <p class="section__lead ts-body-lg-regular measure">{a.lead}</p>
      </div>
      <ul class="info-grid">
        {a.sections.map((s, i) => (
          <li class="info-card">
            <Icon name={ICON[i] ?? "file"} class="info-card__icon" />
            <h2 class="info-card__title ts-title-t4">{s.title}</h2>
            <p class="info-card__detail ts-body-md-regular">{s.detail}</p>
            <p class="info-card__label ts-label-sm">{a.pending}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
