---
// Корінь: завжди /en/ (мова браузера не враховується). UK — через перемикач у шапці.
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---
<!doctype html>
<html lang="en" data-brand="site">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Andrey Ozerov</title>
    <link rel="alternate" hreflang="en" href={`${base}en/`} />
    <link rel="alternate" hreflang="uk" href={`${base}uk/`} />
    <script is:inline define:vars={{ base }}>
      location.replace(base + "en/");
    </script>
    <noscript><meta http-equiv="refresh" content={`0; url=${base}en/`} /></noscript>
  </head>
  <body><p><a href={`${base}en/`}>English</a> · <a href={`${base}uk/`}>Українська</a></p></body>
</html>
